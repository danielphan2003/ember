#!/bin/sh
# Runs cargo natively when installed, otherwise in a container, so a stock
# host needs only podman (or docker). Builds target musl, so both binaries
# are static and the guest agent runs in any image.
set -eu
if command -v cargo >/dev/null 2>&1; then exec cargo "$@"; fi
engine=$(command -v podman || command -v docker) || { echo "need cargo, podman or docker" >&2; exit 1; }
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
tty=""; [ -t 0 ] && tty="-t"
exec "$engine" run --rm $tty -v "$root":/src:Z -w /src \
    -v ember-cargo-registry:/usr/local/cargo/registry:z -v ember-rustup:/usr/local/rustup:z \
    -e CARGO_TARGET_DIR=/src/target -e EMBER_AGENT="${EMBER_AGENT:-}" \
    -e EMBER_E2E_CONFIG="${EMBER_E2E_CONFIG:-}" \
    "${RUST_IMAGE:-docker.io/library/rust:1-alpine}" sh -c '
        command -v cc >/dev/null || apk add -q musl-dev >/dev/null
        case "$1" in fmt|clippy) rustup component add rustfmt clippy >/dev/null 2>&1 ;; esac
        exec cargo "$@"' cargo "$@"
