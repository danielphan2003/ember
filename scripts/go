#!/bin/sh
# Runs go natively when installed, otherwise in a container, so a stock host
# needs only podman (or docker).
set -eu
if command -v go >/dev/null 2>&1; then exec go "$@"; fi
engine=$(command -v podman || command -v docker) || { echo "need go, podman or docker" >&2; exit 1; }
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
tty=""; [ -t 0 ] && tty="-t"
exec "$engine" run --rm $tty -v "$root":/src:Z -v ember-gomod:/go -v ember-gobuild:/root/.cache -w /src \
    -e CGO_ENABLED=0 -e EMBER_E2E_CONFIG="${EMBER_E2E_CONFIG:-}" \
    "${GO_IMAGE:-docker.io/library/golang:1.26-bookworm}" go "$@"
