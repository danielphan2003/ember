[Unit]
Description=ember: Forgejo Actions jobs in Firecracker microVMs
Documentation=https://github.com/danielphan2003/ember
Requires=ember-host.service
After=ember-host.service network-online.target
Wants=network-online.target

[Service]
User=ember
Group=ember
ExecStart=/usr/local/bin/ember serve --config /etc/ember/config.yaml
RuntimeDirectory=ember
RuntimeDirectoryMode=0750
StateDirectory=ember
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2
# Stopping kills every VM in the cgroup.
KillMode=control-group
TimeoutStopSec=30

# Sandbox. Firecracker needs /dev/kvm and the taps (/dev/net/tun); mke2fs
# needs an unprivileged user namespace to build root filesystems.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
