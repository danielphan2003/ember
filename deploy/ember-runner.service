[Unit]
Description=Forgejo runner whose jobs run in ember microVMs
Documentation=https://github.com/danielphan2003/ember
Wants=ember.service network-online.target
After=ember.service network-online.target

[Service]
User=forgejo-runner
Group=forgejo-runner
SupplementaryGroups=ember
StateDirectory=forgejo-runner
WorkingDirectory=/var/lib/forgejo-runner
Environment=HOME=/var/lib/forgejo-runner
ExecStart=/usr/local/bin/forgejo-runner --config /etc/ember/runner.yaml daemon
# The token is a systemd credential, encrypted to this host (TPM when there
# is one): see "Connect to Forgejo" in the README.
LoadCredentialEncrypted=forgejo-token:/etc/ember/forgejo-token.cred
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
